#!/usr/bin/env bash
#
# Checks that `install.sh` is executable.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM |
    grep -E '(^|/)install\.sh$' || true)

for file in $staged; do
    mode=$(git ls-files --stage -- "$file" | awk '{print $1}')

    if [ "$mode" = "100644" ]; then
        echo "pre-commit: $file must be executable"
        echo "Run: chmod +x $file && git add $file"
        exit 1
    fi
done