#!/usr/bin/env bash
#
# Marks every staged install.sh executable in git's index.
#
# Git records the executable bit itself, separately from the filesystem. A
# file authored on Windows is committed as mode 100644 no matter what `ls -l`
# says under WSL, and then fails on the runner with "Permission denied" —
# after the checkout, in CI, long after the mistake was made.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
set -euo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM \
         | grep -E '(^|/)install\.sh$' || true)

for file in $staged; do
    mode=$(git ls-files --stage -- "$file" | awk '{print $1}')
    if [ "$mode" = "100644" ]; then
        git update-index --chmod=+x -- "$file"
        echo "pre-commit: marked $file executable (was $mode)"
    fi
done
